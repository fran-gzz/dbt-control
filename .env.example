NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Solo servidor (resumen semanal por email)
# Crear una API key en https://resend.com/api-keys
RESEND_API_KEY=
# El remitente debe estar verificado en Resend.
# El dominio de prueba "onboarding@resend.dev" solo puede enviar al email de tu cuenta de Resend.
EMAIL_FROM=DBT Control <onboarding@resend.dev>

# Cuenta de servicio de Firebase (JSON) para el resumen semanal
# En Firebase Console: Project settings > Service accounts > Generate new private key.
# En Vercel, pegar el JSON en una variable llamada FIREBASE_SERVICE_ACCOUNT
FIREBASE_SERVICE_ACCOUNT=

# Secreto del cron. Si existe una variable CRON_SECRET, Vercel la envía automáticamente
# como cabecera "Authorization: Bearer <CRON_SECRET>" al invocar el cron.
CRON_SECRET=
